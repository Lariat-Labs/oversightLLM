# Copy to .env, or run `make setup` to discover and fill these for you.

# --- required
# Foundry project endpoint (Foundry portal → project overview)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Log Analytics workspace (customerId GUID) behind the Application Insights resource your agents trace to
LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Model deployment the judge uses for intent, fleet summaries and eval suggestions
JUDGE_MODEL_DEPLOYMENT=gpt-5-mini

# --- tracing (optional): traces the judge as gen_ai.agent.id = oversight-judge
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- optional
# AZURE_TENANT_ID=                 # tenant for `az login --use-device-code`
# AZURE_SUBSCRIPTION_ID=           # subscription to select after login
# AZURE_OPENAI_ENDPOINT=           # default: https://<resource>.openai.azure.com/openai/v1
# OVERSIGHT_EVAL_DEPLOYMENT=       # grader model for Foundry evals (default: judge deployment)
# OVERSIGHT_PORT=8080
# OVERSIGHT_HOST=127.0.0.1         # local only; set 0.0.0.0 to expose (the API has no auth)
# OVERSIGHT_AUTO_JUDGE=false       # start with the auto-judge switch on (it can also be toggled in the UI)
# OVERSIGHT_CORS_ORIGINS=*         # comma-separated origins allowed to embed the frontend
# OVERSIGHT_POLL_INTERVAL=15s      # how often to pull new spans for the live stream
# OVERSIGHT_LOOKBACK=168h          # activity window kept in memory
# OVERSIGHT_MAX_SPANS=5000
# OVERSIGHT_DATA_DIR=./data        # eval cases + judge cache
# OVERSIGHT_WEB_DIR=../web/dist    # serve the built frontend from the API
# AZ_CLI_PATH=az
# VITE_OVERSIGHT_API=http://127.0.0.1:8080   # API base used by the frontend dev server
